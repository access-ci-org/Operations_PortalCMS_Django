# Django Configuration
APP_CONFIG=/soft/django-cms-01/conf/portal.conf.dev.json
DEBUG=True
DEVELOPMENT_SERVER_BANNER=True
DEVELOPMENT_SERVER_LABEL=DEVELOPMENT SERVER
ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_USER=portal_django
DJANGO_PASS=your-database-password

# Database Configuration
DB_DATABASE=portal1
DB_PORT=5432
DB_HOSTNAME_READ=opsdb-dev.cluster-clabf5kcvwmz.us-east-2.rds.amazonaws.com
DB_HOSTNAME_WRITE=opsdb-dev.cluster-clabf5kcvwmz.us-east-2.rds.amazonaws.com
DB_SEARCH_PATH="$user",public
DB_SSLMODE=require

# Static Files
STATIC_ROOT=/path/to/static/files

# Application Settings
APP_LOG=/path/to/logs/portalcms.log
APP_VERSION=1.0.0
SYSLOG_SOCK=/var/run/syslog

# API Configuration
API_BASE=
API_KEY=your-api-key-here

# CILogon OAuth2 Configuration
CILOGON_CLIENT_ID=cilogon:/client_id/your-app-id
CILOGON_CLIENT_SECRET=your-cilogon-secret-here
